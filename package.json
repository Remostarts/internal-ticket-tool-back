{
  "name": "@claimdesk/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Claim Desk API - Express, Mongoose and Socket.IO",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cover": "vitest run --coverage",
    "seed:dev": "tsx src/scripts/seed-dev.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.3.0",
    "mammoth": "^1.12.3",
    "mongoose": "^8.8.1",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.10",
    "pdf-parse": "^1.1.1",
    "pino": "^9.14.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pdf-parse": "^1.1.5",
    "@types/supertest": "^6.0.3",
    "mongodb-memory-server": "^10.4.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "vitest": "^2.1.9"
  }
